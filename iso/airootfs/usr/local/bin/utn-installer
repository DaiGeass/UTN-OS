        self.chk_encrypt.toggled.connect(self.luks_pass2.setEnabled)
        v.addWidget(self.luks_pass2)

        self.chk_firewall = make_chk(
            "Activar firewall (nftables: bloquea entradas, permite salidas)",
            True, "Reglas simples de firewall incluidas en el sistema.")
        self.chk_plymouth = make_chk(
            "Usar pantalla de carga (Plymouth)",
            False, "Requiere internet.")
        self.chk_snapper = make_chk(
            "Snapshots automáticos del sistema (solo btrfs)",
            False, "Requiere internet y que el filesystem sea btrfs.")
        self.chk_updates = make_chk(
            "Instalar actualizaciones al terminar",
            False, "Requiere internet. Actualiza todo el sistema.")
        v.addStretch(1)
        self._add_page(page)

