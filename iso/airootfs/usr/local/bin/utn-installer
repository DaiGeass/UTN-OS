#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Instalador gráfico de UTN OS (estilo asistente).

Pasos: bienvenida/teclado -> disco -> usuarios -> resumen -> instalación -> fin.
Corre como root en el live y copia el sistema live al disco de destino.
"""
import json
import fcntl
import functools
import os
import pwd
import re
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import time

from PyQt5 import QtCore, QtGui, QtWidgets

sys.path.insert(0, "/usr/share/utn-os")
import utn_theme as UT

LOGO = "/usr/share/pixmaps/utn-os.png"

MOUNT = "/mnt/utnroot"
LIVE_SFS = "/run/archiso/bootmnt/arch/x86_64/airootfs.sfs"
LIVE_BOOT = "/run/archiso/bootmnt/arch/boot/x86_64"
GIB = 1024 ** 3
COPY_EXCLUDES = [
    "/dev", "/proc", "/sys", "/run", "/tmp", "/mnt", "/media",
    "/lost+found", "/var/cache/pacman/pkg", "/etc/machine-id",
    "/etc/hostname", "/etc/fstab", "/.wh.*", "/root/.ssh",
    "/etc/xdg/autostart/utn-welcome.desktop",
    "/etc/xdg/autostart/utn-installer.desktop",
    "/usr/local/bin/utn-installer-live", "/usr/local/bin/utn-welcome",
]

LAYOUT_DIR = "/usr/share/utn-os/layouts"
TIMEZONES = [
    "America/Argentina/Buenos_Aires",
    "America/Mexico_City",
    "America/Monterrey",
    "America/Bogota",
    "America/Caracas",
    "America/Lima",
    "America/Santiago",
    "America/Sao_Paulo",
    "Europe/Madrid",
]
KEYBOARDS = ["es", "latam", "us", "br", "fr", "de", "pt", "it", "gb"]
LOCALES = ["es_MX.UTF-8", "es_AR.UTF-8", "es_ES.UTF-8", "en_US.UTF-8",
           "pt_BR.UTF-8", "fr_FR.UTF-8", "de_DE.UTF-8", "it_IT.UTF-8"]
CONSOLE_KEYMAP = {
    "es": "es", "latam": "la-latin1", "us": "us", "br": "br-abnt2", "fr": "fr",
    "de": "de", "pt": "pt-latin1", "it": "it", "gb": "uk",
}
FILESYSTEMS = ["ext4", "btrfs", "xfs", "jfs", "f2fs"]
def ui_stylesheet(scale=1.0):
    """Hoja de estilos compartida (verde+azul, claro/oscuro)."""
    return UT.stylesheet(UT.current_theme(), scale)


def ui_scale():
    """Factor de escala para pantallas grandes (p.ej. 4K o ultrawide)."""
    return UT.ui_scale()


def run(cmd, check=True, timeout=900):
    """Ejecuta y recoge el proceso; un timeout nunca deja hijos escribiendo."""
    p = subprocess.Popen(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        start_new_session=True,
    )
    try:
        out, _ = p.communicate(timeout=timeout)
    except BaseException:
        stop_process(p)
        raise
    if check and p.returncode != 0:
        raise RuntimeError(f"Fallo: {' '.join(cmd)}\n{out}")
    return out


def stop_process(process):
    if process.poll() is None:
        try:
            os.killpg(process.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
    process.wait()


@functools.lru_cache(maxsize=1)
def system_size():
    cmd = ["du", "-sx", "--block-size=1"]
    cmd += [f"--exclude={path}" for path in COPY_EXCLUDES]
    size = int(run(cmd + ["/"], timeout=300).split()[0])
    if size <= 0:
        raise RuntimeError("No se pudo calcular el espacio requerido por el live.")
    return size


def required_disk_bytes(swap):
    # Margen para actualizaciones y metadatos, además de EFI y alineación.
    root = max(12 * GIB, int(system_size() * 1.25) + 2 * GIB)
    return root + swap * GIB + (512 * 1024 ** 2 if is_uefi() else 0) + 16 * 1024 ** 2


def validate_target(disk, swap):
    data = json.loads(run(["lsblk", "-Jbp", "-o", "NAME,TYPE,SIZE,RO,MOUNTPOINTS", disk]))
    devices = data.get("blockdevices", [])
    if len(devices) != 1 or devices[0]["type"] != "disk":
        raise RuntimeError("Elegí un disco completo disponible.")
    device = devices[0]
    if os.path.realpath(device["name"]) != os.path.realpath(disk) or device.get("ro"):
        raise RuntimeError("El disco cambió o es de sólo lectura. Actualizá la lista.")
    pending = [device]
    while pending:
        node = pending.pop()
        if any(node.get("mountpoints") or []) or node.get("type") not in {"disk", "part"}:
            raise RuntimeError("El disco está en uso (puede ser el USB live). Elegí otro.")
        pending.extend(node.get("children", []))
    needed = required_disk_bytes(swap)
    if int(device["size"]) < needed:
        raise RuntimeError(f"No hay espacio: se requieren al menos {needed / GIB:.1f} GiB "
                           "incluyendo sistema, swap y margen libre.")


def username_available(name):
    if name in {"root", "nobody", "daemon", "bin", "sync"}:
        return False
    try:
        pwd.getpwnam(name)
    except KeyError:
        return True
    return False


def kernel_source():
    release = os.uname().release
    if not os.path.isdir(f"/usr/lib/modules/{release}"):
        raise RuntimeError("Faltan los módulos del kernel del live. Reiniciá con la ISO original.")
    for path in (f"/usr/lib/modules/{release}/vmlinuz", f"{LIVE_BOOT}/vmlinuz-linux",
                 "/boot/vmlinuz-linux"):
        if os.path.isfile(path) and os.path.getsize(path) > 0:
            return path
    raise RuntimeError("No se encontró el kernel del live; no se modificó el disco.")


def write_private(path, content):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w") as stream:
        stream.write(content)


def is_uefi():
    return os.path.isdir("/sys/firmware/efi")


def discover_layouts():
    """Lista los layouts disponibles desde /usr/share/utn-os/layouts (meta.toml)."""
    try:
        out = run(["utn-layouts"], check=False)
        data = json.loads(out)
        if isinstance(data, list):
            return data
    except (json.JSONDecodeError, OSError):
        pass
    if os.path.isdir(LAYOUT_DIR):
        return [{"id": d, "display": d, "description": "", "default": False}
                for d in sorted(os.listdir(LAYOUT_DIR))]
    return []


def disks():
    """"Lista de discos (sata, nvme, virtio), sin loop/ram/rom."""
    out = run(["lsblk", "-J", "-o", "NAME,SIZE,MODEL,TYPE,TRAN"], check=False)
    try:
        data = json.loads(out)
    except json.JSONDecodeError:
        return []
    devs = []
    for d in data.get("blockdevices", []):
        name = d.get("name", "")
        if (d.get("type") == "disk"
                and re.match(r"^(sd|hd|vd|nvme)", name)):
            devs.append(d)
    return devs


class InstallWorker(QtCore.QThread):
    log = QtCore.pyqtSignal(str)
    progress = QtCore.pyqtSignal(int)
    done = QtCore.pyqtSignal(bool, str)

    def __init__(self, opts, parent=None):
        super().__init__(parent)
        self.opts = opts
        self._mounted = False
        self._swap_device = None
        self._mapper_open = False
        self._copy_process = None
        self.cleanup_ok = True

    def _log(self, msg, progress=None):
        for key in ("password", "root_password", "luks_passphrase"):
            if self.opts.get(key):
                msg = msg.replace(self.opts[key], "[oculto]")
        self.log.emit(msg)
        if progress is not None:
            self.progress.emit(progress)

    def run(self):
        error = None
        try:
            self.install()
        except Exception as exc:
            error = str(exc)
        finally:
            cleanup_errors = self._cleanup()
            self.cleanup_ok = not cleanup_errors
            if cleanup_errors:
                error = (error or "No se pudo finalizar la instalación.") + "\n" + "\n".join(cleanup_errors)
        if error:
            for key in ("password", "root_password", "luks_passphrase"):
                if self.opts.get(key):
                    error = error.replace(self.opts[key], "[oculto]")
            self._log(f"\n[ERROR] {error}")
        for key in ("password", "root_password", "luks_passphrase"):
            self.opts.pop(key, None)
        if error:
            self.done.emit(False, error)
        else:
            self.progress.emit(100)
            self.done.emit(True, "Instalación completada. Reiniciá y retirá el medio live.")

    def _cleanup(self):
        errors = []
        if self._copy_process is not None:
            try:
                stop_process(self._copy_process)
                self._copy_process = None
            except Exception as exc:
                errors.append(f"No se pudo detener la copia: {exc}")
        if self._swap_device:
            try:
                run(["swapoff", self._swap_device])
                self._swap_device = None
            except Exception as exc:
                errors.append(f"No se pudo desactivar swap: {exc}")
        if self._mounted:
            try:
                run(["umount", "-R", MOUNT])
                self._mounted = False
            except Exception as exc:
                errors.append(f"No se pudo desmontar el destino: {exc}")
        if self._mapper_open and not self._mounted:
            try:
                run(["cryptsetup", "close", "utnroot"])
                self._mapper_open = False
            except Exception as exc:
                errors.append(f"No se pudo cerrar LUKS: {exc}")
        return errors

    # ---------------------------------------------------------------- steps
    def _parted_bios(self, disk):
        run(["parted", "-s", "--", disk, "mklabel", "msdos"])
        swap = self.opts["swap"]
        if swap:
            run(["parted", "-s", "--", disk, "mkpart", "primary", "ext4",
                 "1MiB", f"-{swap}GiB"])
            run(["parted", "-s", "--", disk, "set", "1", "boot", "on"])
            run(["parted", "-s", "--", disk, "mkpart", "primary", "linux-swap",
                 f"-{swap}GiB", "100%"])
        else:
            run(["parted", "-s", "--", disk, "mkpart", "primary", "ext4",
                 "1MiB", "100%"])
            run(["parted", "-s", "--", disk, "set", "1", "boot", "on"])

    def _sgdisk_uefi(self, disk):
        run(["sgdisk", "--zap-all", disk])
        run(["sgdisk", "--clear", disk])
        run(["sgdisk", "-n", "1:0:+512M", "-t", "1:ef00", "-c", "1:EFI", disk])
        swap = self.opts["swap"]
        if swap:
            run(["sgdisk", "-n", "2:0:-{}G".format(swap), "-t", "2:8304",
                 "-c", "2:ROOT", disk])
            run(["sgdisk", "-n", "3:0:0", "-t", "3:8200", "-c", "3:SWAP",
                 disk])
        else:
            run(["sgdisk", "-n", "2:0:0", "-t", "2:8304", "-c", "2:ROOT",
                 disk])

    def _wait_partitions(self, disk, count):
        run(["partprobe", disk])
        base = os.path.basename(disk)
        for _ in range(20):
            parts = run(["lsblk", "-lno", "NAME", disk], check=False)
            names = [p.strip() for p in parts.splitlines() if p.strip()]
            if len(names) >= count + 1:
                return names[1:]
            time.sleep(0.5)
        raise RuntimeError("No se reconocieron las particiones creadas")

    def install(self):
        opts = self.opts
        disk = opts["disk"]
        fs = opts["filesystem"]
        swap = opts["swap"]

        if not os.path.isfile(LIVE_SFS):
            raise RuntimeError("La instalación sólo está disponible desde el live de UTN OS.")
        if os.path.ismount(MOUNT) or os.path.exists("/dev/mapper/utnroot"):
            raise RuntimeError("Quedan recursos de otra instalación. Reiniciá el live antes de reintentar.")
        if not username_available(opts["username"]):
            raise RuntimeError("El nombre de usuario ya existe o está reservado.")
        required = ["rsync", "lsblk", "du", "mount", "umount", "partprobe", "blkid",
                    "genfstab", "arch-chroot", "grub-install", "grub-mkconfig", "mkinitcpio",
                    f"mkfs.{fs}", "sgdisk" if is_uefi() else "parted"]
        if is_uefi():
            required.append("mkfs.vfat")
        if swap:
            required += ["mkswap", "swapon", "swapoff"]
        if opts.get("encrypt"):
            required.append("cryptsetup")
            if swap:
                raise RuntimeError("Esta versión requiere desactivar swap para cifrar el sistema.")
        missing = [name for name in required if shutil.which(name) is None]
        if missing:
            raise RuntimeError("Faltan herramientas en la ISO: " + ", ".join(missing))
        validate_target(disk, swap)
        self._kernel_source = kernel_source()

        self._log("==" * 30)
        self._log("   INSTALL UTNOS  -  by DaiGeass/ZZERO")
        self._log("==" * 30)
        self._log(f"Sistema: {'UEFI' if is_uefi() else 'BIOS'}")
        self._log(f"Disco:   {disk}")
        self._log(f"Sistema de archivos raíz: {fs}")
        self._log(f"Swap:    {swap} GiB" if swap else "Swap: no")

        steps = [
            ("Particionando disco", 2, lambda: self._partition(disk, fs, swap)),
            ("Formateando particiones", 8, lambda: self._format(disk, fs, swap)),
            ("Montando particiones", 15, lambda: self._mount(disk)),
            ("Copiando sistema (rsync)", 20, self._copy_system),
            ("Configurando sistema", 80, lambda: self._configure(disk)),
            ("Instalando GRUB", 92, lambda: self._grub(disk)),
            ("Comprobando archivos de arranque", 97, self._verify_boot),
        ]
        for name, pct, action in steps:
            self._log(f"\n== {name} ==")
            self.progress.emit(pct)
            action()

    def _partition(self, disk, fs, swap):
        if is_uefi():
            self._sgdisk_uefi(disk)
        else:
            self._parted_bios(disk)

        expected = (2 if is_uefi() else 1) + (1 if swap else 0)
        parts = self._wait_partitions(disk, expected)
        if len(parts) < expected:
            raise RuntimeError("Particionado falló")
        self.opts["parts"] = [f"/dev/{p}" for p in parts]
        self._log(f"Particiones: {', '.join(self.opts['parts'])}")
        return True

    def _format(self, disk, fs, swap):
        parts = self.opts["parts"]
        if is_uefi():
            efi, rootish = parts[0], parts[1]
            root = rootish
            run(["mkfs.vfat", "-F32", "-n", "EFI", efi])
            self._log(f"  EFI  {efi}  (vfat)")
        else:
            root = parts[0]
        # Cifrado LUKS opcional: formateamos la partición y abrimos el mapper
        encrypt = self.opts.get("encrypt")
        if encrypt:
            with tempfile.NamedTemporaryFile(prefix="utn-luks-", mode="w") as key:
                key.write(self.opts["luks_passphrase"])
                key.flush()
                # /boot está dentro de la raíz cifrada: PBKDF2 es compatible con GRUB.
                run(["cryptsetup", "-q", "--type=luks2", "--pbkdf", "pbkdf2",
                     "luksFormat", "--key-file", key.name, root])
                luks_uuid = run(["blkid", "-s", "UUID", "-o", "value", root]).strip()
                if not luks_uuid:
                    raise RuntimeError("No se obtuvo el UUID de la partición cifrada.")
                try:
                    run(["cryptsetup", "open", "--key-file", key.name, root, "utnroot"])
                finally:
                    self._mapper_open = os.path.exists("/dev/mapper/utnroot")
            self.opts["luks_uuid"] = luks_uuid
            self._log(f"  LUKS  {root}  -> /dev/mapper/utnroot")
            root = "/dev/mapper/utnroot"
        self.opts["root_dev"] = root
        mkfs = {
            "ext4": ["mkfs.ext4", "-F", "-L", "UTNROOT", root],
            "btrfs": ["mkfs.btrfs", "-f", "-L", "UTNROOT", root],
            "xfs": ["mkfs.xfs", "-f", "-L", "UTNROOT", root],
            "jfs": ["mkfs.jfs", "-q", "-L", "UTNROOT", root],
            "f2fs": ["mkfs.f2fs", "-f", "-l", "UTNROOT", root],
        }[fs]
        self._log(f"  ROOT {root}  ({fs})")
        run(mkfs)
        if swap:
            run(["mkswap", "-L", "swap", parts[-1]])
            self._log(f"  SWAP {parts[-1]}")

    def _mount(self, disk):
        parts = self.opts["parts"]
        os.makedirs(MOUNT, exist_ok=True)
        root = self.opts["root_dev"]
        if is_uefi():
            efi = parts[0]
        else:
            efi = None
        run(["mount", root, MOUNT])
        self._mounted = True
        if efi:
            os.makedirs(f"{MOUNT}/boot/efi", exist_ok=True)
            run(["mount", efi, f"{MOUNT}/boot/efi"])
        if self.opts["swap"]:
            run(["swapon", parts[-1]])
            self._swap_device = parts[-1]
        self._log(f"  Montado {root} en {MOUNT}")

    def _copy_system(self):
        cmd = ["rsync", "-aHAXx", "--info=progress2", "--no-i-r", "--stats"]
        for ex in COPY_EXCLUDES:
            cmd.append(f"--exclude={ex}")
        cmd += ["/", f"{MOUNT}/"]
        self._log("  Copiando sistema raíz (puede tardar unos minutos)...")
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                             stderr=subprocess.STDOUT, text=True, start_new_session=True)
        self._copy_process = p
        last_progress = 20
        try:
            # TextIO convierte CR, LF y CRLF en líneas, incluso partidas entre lecturas.
            for line in p.stdout:
                line = line.strip()
                if not line:
                    continue
                m = re.search(r"(\d+(\.\d+)?)%", line)
                if m:
                    pct = max(last_progress, min(79, 20 + int(float(m.group(1)) * .59)))
                    if pct != last_progress:
                        self.progress.emit(pct)
                        last_progress = pct
                else:
                    self._log(line)
            p.wait()
        finally:
            stop_process(p)
            p.stdout.close()
            self._copy_process = None
        if p.returncode != 0:
            raise RuntimeError("rsync falló al copiar el sistema")
        self.progress.emit(79)
        self._log("  Copia del sistema finalizada")

    def _configure(self, disk):
        opt = self.opts
        q = lambda s: shlex.quote(str(s))
        console = CONSOLE_KEYMAP[opt['keyboard']]
        for name in ('dev', 'proc', 'sys', 'run', 'mnt', 'media', 'etc', 'boot', 'tmp', 'var/tmp'):
            os.makedirs(f'{MOUNT}/{name}', exist_ok=True)
        os.chmod(f'{MOUNT}/tmp', 0o1777)
        os.chmod(f'{MOUNT}/var/tmp', 0o1777)
        # Vacío, no ausente: generar un ID propio al arrancar sin volver a aplicar
        # los presets de primer arranque (reactivarían systemd-networkd).
        with open(f'{MOUNT}/etc/machine-id', 'w'):
            pass
        os.chmod(f'{MOUNT}/etc/machine-id', 0o444)
        with open(f'{MOUNT}/etc/motd', 'w') as fh:
            fh.write('Bienvenido a UTN OS.\n')
        shutil.copy2(self._kernel_source, f'{MOUNT}/boot/vmlinuz-linux')

        fstab = run(['genfstab', '-U', MOUNT])
        entries = [line.split() for line in fstab.splitlines()
                   if line.strip() and not line.lstrip().startswith('#')]
        if not any(len(entry) >= 3 and entry[1] == '/' for entry in entries):
            raise RuntimeError('genfstab no generó una entrada para la raíz. Instalación detenida.')
        if is_uefi() and not any(len(entry) >= 3 and entry[1] == '/boot/efi' for entry in entries):
            raise RuntimeError('Falta la partición EFI en fstab.')
        # genfstab puede listar swap ajena al destino, activa en el live.
        entries = [entry for entry in entries if len(entry) >= 3 and entry[1] in ('/', '/boot/efi')]
        if self._swap_device:
            swap_uuid = run(['blkid', '-s', 'UUID', '-o', 'value', self._swap_device]).strip()
            if not swap_uuid:
                raise RuntimeError('No se obtuvo el UUID de la swap del destino.')
            entries.append([f'UUID={swap_uuid}', 'none', 'swap',
                            'defaults,nofail,x-systemd.device-timeout=5min', '0', '0'])
        with open(f'{MOUNT}/etc/fstab', 'w') as fh:
            fh.write('\n'.join('\t'.join(entry) for entry in entries) + '\n')
        # Un resolv.conf regular evita copiar un enlace roto al /run del live.
        resolv = f'{MOUNT}/etc/resolv.conf'
        if os.path.islink(resolv):
            os.unlink(resolv)
        shutil.copyfile('/etc/resolv.conf', resolv)

        hooks = ['base', 'udev', 'autodetect', 'microcode', 'modconf', 'kms',
                 'keyboard', 'keymap', 'consolefont', 'block']
        if opt.get('encrypt'):
            hooks.append('encrypt')
            if not opt.get('luks_uuid'):
                raise RuntimeError('Falta el UUID LUKS; no se puede configurar el arranque.')
            with open(f'{MOUNT}/etc/crypttab', 'w') as fh:
                fh.write(f"utnroot UUID={opt['luks_uuid']} none luks\n")
        hooks += ['filesystems', 'fsck']

        extras = []
        if opt.get('firewall'):
            extras.append('''
command -v nft >/dev/null
cat > /etc/nftables.conf <<'NFT'
flush ruleset
table inet filter {
  chain input { type filter hook input priority filter; policy drop;
    ct state established,related accept
    iif "lo" accept
    ip protocol icmp accept
    meta l4proto ipv6-icmp accept
    udp sport 67 udp dport 68 accept
    udp sport 547 udp dport 546 accept
  }
  chain forward { type filter hook forward priority filter; policy drop; }
  chain output { type filter hook output priority filter; policy accept; }
}
NFT
nft --check --file /etc/nftables.conf
systemctl enable nftables
echo 'OK: firewall configurado para el siguiente arranque.'
''')
        for key, package in [('plymouth', 'plymouth'), ('snapper', 'snapper')]:
            if opt.get(key):
                extras.append(f'''if pacman -Q {package} >/dev/null 2>&1; then
    echo 'OK: {package} disponible.'
elif online; then
    # Una actualización completa evita actualizaciones parciales de Arch.
    pacman -Syu --needed --noconfirm {package}
    echo 'OK: {package} instalado.'
else
    echo 'AVISO: {package} omitido; no hay conexión al repositorio.'
fi
''')
        if opt.get('updates'):
            extras.append('''if online; then
    pacman -Syu --noconfirm
    echo 'OK: sistema actualizado.'
else
    echo 'AVISO: actualizaciones omitidas; no hay conexión.'
fi
''')
        if opt.get('snapper'):
            extras.append('''if pacman -Q snapper >/dev/null 2>&1; then
    snapper -c root create-config /
    systemctl enable snapper-timeline.timer snapper-cleanup.timer
    echo 'OK: snapshots configurados.'
fi
''')
        if opt.get('plymouth'):
            extras.append('''if pacman -Q plymouth >/dev/null 2>&1; then
    # Sólo añadir el hook cuando existe; el arranque offline sigue siendo válido.
    test -f /usr/lib/initcpio/install/plymouth
    HOOKS="${HOOKS/ kms / kms plymouth }"
    echo 'OK: pantalla de carga habilitada.'
fi
''')

        # arch-chroot monta un tmpfs nuevo sobre /tmp y oculta su contenido.
        # /var/tmp sigue visible; el directorio privado se elimina incluso si falla.
        with tempfile.TemporaryDirectory(prefix='utn-setup-', dir=f'{MOUNT}/var/tmp') as secret_dir:
            relative_dir = '/var/tmp/' + os.path.basename(secret_dir)
            password_file = f'{secret_dir}/chpasswd.in'
            write_private(password_file,
                          f"{opt['username']}:{opt['password']}\nroot:{opt['root_password']}\n")
            autologin = ''
            if opt.get('autologin'):
                autologin = f"printf '[Autologin]\\nUser=%s\\nSession=lxqt\\n' {q(opt['username'])} > /etc/sddm.conf.d/autologin.conf"
            script = f'''#!/bin/bash
set -euo pipefail
trap 'echo "ERROR: configuración detenida en línea $LINENO" >&2' ERR
# rsync -x no copia el keyring temporal montado por el live.
# Crear uno propio sin red y recoger los agentes antes de desmontar el destino.
trap 'gpgconf --homedir /etc/pacman.d/gnupg --kill all || true' EXIT
online() {{ curl --head --fail --location --silent --connect-timeout 3 --max-time 8 https://archlinux.org >/dev/null 2>&1; }}
echo '== Configurando sistema =='
ln -sf /usr/share/zoneinfo/{opt['timezone']} /etc/localtime
printf '%s\\n' {q(opt['hostname'])} > /etc/hostname
printf '127.0.0.1 localhost\\n::1 localhost\\n127.0.1.1 %s.localdomain %s\\n' {q(opt['hostname'])} {q(opt['hostname'])} > /etc/hosts
# locale-gen debe terminar correctamente.
grep -qxF '{opt['locale']} UTF-8' /etc/locale.gen || echo '{opt['locale']} UTF-8' >> /etc/locale.gen
locale-gen
printf 'LANG={opt['locale']}\\n' > /etc/locale.conf
printf 'KEYMAP={console}\\n' > /etc/vconsole.conf
mkdir -p /etc/X11/xorg.conf.d
cat > /etc/X11/xorg.conf.d/00-keyboard.conf <<'XEOF'
Section "InputClass"
    Identifier "keyboard-layout"
    MatchIsKeyboard "on"
    Option "XkbLayout" "{opt['keyboard']}"
EndSection
XEOF
if id -u {q(opt['username'])} >/dev/null 2>&1; then
    echo 'ERROR: el usuario elegido ya existe en el sistema destino.' >&2
    exit 1
fi
useradd -m -G wheel -s /bin/bash -c {q(opt['fullname'])} {q(opt['username'])}
chpasswd < {q(relative_dir + '/chpasswd.in')}
rm -f -- {q(relative_dir + '/chpasswd.in')}
mkdir -p /etc/sudoers.d
printf '%s ALL=(ALL) ALL\\n' {q(opt['username'])} > /etc/sudoers.d/10-{opt['username']}
chmod 440 /etc/sudoers.d/10-{opt['username']}
visudo -cf /etc/sudoers.d/10-{opt['username']}
mkdir -p /etc/sddm.conf.d
rm -f /etc/sddm.conf.d/autologin.conf
{autologin}
LAYOUT={q('/usr/share/utn-os/layouts/' + opt['layout'])}
for f in panel.conf lxqt.conf; do
    install -Dm644 "$LAYOUT/lxqt/$f" "/etc/xdg/lxqt/$f"
done
install -Dm644 "$LAYOUT/openbox/rc.xml" /etc/xdg/openbox/rc.xml
install -Dm644 "$LAYOUT/pcmanfm/settings.conf" /etc/xdg/pcmanfm-qt/lxqt/settings.conf
install -Dm644 "$LAYOUT/picom.conf" /etc/xdg/picom.conf
if [ -f "$LAYOUT/kvantum/kvantum.kvconfig" ]; then
    install -Dm644 "$LAYOUT/kvantum/kvantum.kvconfig" /etc/xdg/Kvantum/kvantum.kvconfig
fi
# Retirar accesos exclusivos del live del nuevo usuario y de skel.
find /home /etc/skel /root/Desktop -name 'utn-os-*.desktop' -delete 2>/dev/null || true
rm -f /usr/share/applications/utn-os-welcome.desktop /usr/share/applications/utn-os-installer.desktop
rm -f /usr/local/share/applications/utn-installer.desktop
sed -i '/desktop=.*utn-os-installer.desktop/d' /etc/xdg/lxqt/panel.conf
rm -rf /etc/mkinitcpio.conf.d /etc/mkinitcpio.d /etc/systemd/system/getty@tty1.service.d
rm -f /root/.ssh/authorized_keys /etc/ssh/sshd_config.d/10-archiso.conf /etc/ssh/sshd_config.d/99-utn-debug.conf
# El verificador BPF de nsresourced puede superar 90s bajo emulación TCG.
# Dar tiempo a que termine, conservando todas sus restricciones.
if systemd-detect-virt --vm --quiet; then
    mkdir -p /etc/systemd/system/systemd-nsresourced.service.d
    printf '[Service]\\nTimeoutStartSec=5min\\n' > /etc/systemd/system/systemd-nsresourced.service.d/10-utn-emulation.conf
fi
# No conservar servicios ni reglas de red propios del live.
for unit in sshd iwd systemd-networkd systemd-networkd-wait-online systemd-time-wait-sync choose-mirror pacman-init; do
    systemctl disable "$unit" 2>/dev/null || true
done
systemctl disable systemd-networkd.socket 2>/dev/null || true
rm -f /etc/systemd/network/20-ethernet.network /etc/systemd/network/20-wlan.network /etc/systemd/network/20-wwan.network
rm -f /etc/systemd/system/etc-pacman.d-gnupg.mount
pacman-key --init
pacman-key --populate archlinux
HOOKS={q(' '.join(hooks))}
{''.join(extras)}
printf 'HOOKS=(%s)\\nCOMPRESSION="zstd"\\n' "$HOOKS" > /etc/mkinitcpio.conf
mkdir -p /etc/mkinitcpio.d
cat > /etc/mkinitcpio.d/linux.preset <<'PRESET'
PRESETS=('default' 'fallback')
ALL_kver='/boot/vmlinuz-linux'
default_config='/etc/mkinitcpio.conf'
default_image='/boot/initramfs-linux.img'
fallback_config='/etc/mkinitcpio.conf'
fallback_image='/boot/initramfs-linux-fallback.img'
fallback_options='-S autodetect'
PRESET
mkinitcpio -P
test -s /boot/vmlinuz-linux
test -s /boot/initramfs-linux.img
test -s /boot/initramfs-linux-fallback.img
systemctl enable NetworkManager sddm
echo '== Configuración y archivos de arranque verificados =='
'''
            setup_file = f'{secret_dir}/setup.sh'
            write_private(setup_file, script)
            self._log(run(['arch-chroot', MOUNT, '/bin/bash', relative_dir + '/setup.sh'], timeout=3600))
        self._log(f"Usuario: {opt['username']} | Teclado: {console} / {opt['keyboard']}")

    def _verify_boot(self):
        for relative in ('boot/vmlinuz-linux', 'boot/initramfs-linux.img',
                         'boot/initramfs-linux-fallback.img', 'boot/grub/grub.cfg'):
            path = f'{MOUNT}/{relative}'
            if not os.path.isfile(path) or os.path.getsize(path) == 0:
                raise RuntimeError(f'Falta un archivo de arranque válido: /{relative}')
        with open(f'{MOUNT}/boot/grub/grub.cfg') as fh:
            config = fh.read()
        if not re.search(r'^\s*linux\S*\s+.*vmlinuz-linux', config, re.M) or not re.search(
                r'^\s*initrd\S*\s+.*initramfs-linux', config, re.M):
            raise RuntimeError('GRUB no contiene una entrada de kernel e initramfs de UTN OS.')
        if is_uefi() and not os.path.isfile(f'{MOUNT}/boot/efi/EFI/UTN_OS/grubx64.efi'):
            raise RuntimeError('No se encontró el cargador EFI instalado.')

    def _grub(self, disk):
        boot_id = "UTN_OS"
        opt = self.opts
        if opt.get("encrypt") and opt.get("luks_uuid"):
            crypt_device = (f'GRUB_CMDLINE_LINUX='
                            f'"cryptdevice=UUID={opt["luks_uuid"]}:utnroot"')
            cryptodisk = 'GRUB_ENABLE_CRYPTODISK=y'
        else:
            crypt_device = 'GRUB_CMDLINE_LINUX=""'
            cryptodisk = '#GRUB_ENABLE_CRYPTODISK'
        run(["arch-chroot", MOUNT, "/bin/bash", "-c",
             "printf '%s\\n' "
             "'GRUB_DEFAULT=0' "
             "'GRUB_TIMEOUT=5' "
             "'GRUB_DISTRIBUTOR=\"UTN OS\"' "
             f"'{crypt_device}' "
             f"'{cryptodisk}' "
             "'GRUB_BACKGROUND=/boot/grub/utn-splash.png' "
             "'GRUB_GFXMODE=1024x768,800x600,auto' "
             "'GRUB_DISABLE_OS_PROBER=false' "
             "> /etc/default/grub"])
        if is_uefi():
            run(["arch-chroot", MOUNT, "grub-install",
                 "--target=x86_64-efi", "--efi-directory=/boot/efi",
                 f"--bootloader-id={boot_id}", "--recheck"])
        else:
            run(["arch-chroot", MOUNT, "grub-install",
                 "--target=i386-pc", "--recheck", disk])
        run(["arch-chroot", MOUNT, "/bin/bash", "-c",
             "mkdir -p /boot/grub && cp /usr/share/utn-os/splash.png "
             "/boot/grub/utn-splash.png"])
        run(["arch-chroot", MOUNT, "grub-mkconfig", "-o",
             "/boot/grub/grub.cfg"])
        self._log("  GRUB instalado")


class InstallerWindow(QtWidgets.QWidget):
    def __init__(self, scale=1.0):
        super().__init__()
        self.scale = scale
        self._worker = None
        self._opts = {}
        self._install_failed = False
        self.setWindowTitle("INSTALL UTNOS by DaiGeass/ZZERO")
        self.setMinimumSize(int(760 * scale), int(560 * scale))
        self.layout = QtWidgets.QVBoxLayout(self)

        self.stack = QtWidgets.QStackedWidget(self)
        self.layout.addWidget(self.stack)

        self._build_welcome()
        self._build_disk()
        self._build_users()
        self._build_extras()
        self._build_summary()
        self._build_install()
        self._build_finish()

        self.buttons = QtWidgets.QHBoxLayout()
        self.btn_back = QtWidgets.QPushButton("Atrás")
        self.btn_next = QtWidgets.QPushButton("Siguiente")
        self.btn_next.setDefault(True)
        self.btn_back.clicked.connect(self.back)
        self.btn_next.clicked.connect(self.next)
        self.buttons.addStretch(1)
        self.buttons.addWidget(self.btn_back)
        self.buttons.addWidget(self.btn_next)
        self.layout.addLayout(self.buttons)

        self.stack.currentChanged.connect(self._page_changed)
        self.stack.setCurrentIndex(0)
        self._page_changed(0)

    # ---------------------------------------------------------------- pages
    def _add_page(self, widget):
        self.stack.addWidget(widget)

