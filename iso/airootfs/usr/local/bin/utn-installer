        self.chk_snapper = make_chk(
            "Snapshots automáticos del sistema (solo btrfs)",
            False, "Requiere internet y que el filesystem sea btrfs.")
        self.chk_updates = make_chk(
            "Instalar actualizaciones al terminar",
            False, "Requiere internet. Actualiza todo el sistema.")
