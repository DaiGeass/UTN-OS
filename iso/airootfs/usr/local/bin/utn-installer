            "La instalación base funciona sin internet. Los extras que requieren "
            "descargas se omiten si no hay conexión y se informan en el registro."))
        v.addSpacing(8)

        def make_chk(text, default=True, hint=""):
            c = QtWidgets.QCheckBox(text)
            c.setChecked(default)
            if hint:
                c.setToolTip(hint)
            v.addWidget(c)
            return c

        self.chk_encrypt = make_chk(
            "Cifrar disco con LUKS (pide contraseña al arrancar)",
            False, "Cifra toda la partición del sistema.")
        self.luks_pass = QtWidgets.QLineEdit()
        self.luks_pass.setPlaceholderText(
            "Contraseña del disco cifrado (al menos 8 caracteres)")
        self.luks_pass.setEchoMode(QtWidgets.QLineEdit.Password)
        self.luks_pass.setEnabled(False)
        self.chk_encrypt.toggled.connect(self.luks_pass.setEnabled)
        v.addWidget(self.luks_pass)
        self.luks_pass2 = QtWidgets.QLineEdit()
        self.luks_pass2.setPlaceholderText("Confirmar contraseña del disco cifrado")
        self.luks_pass2.setEchoMode(QtWidgets.QLineEdit.Password)
