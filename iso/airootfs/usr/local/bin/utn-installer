    # ------------------------------------------------------------- navigation
    def _page_changed(self, idx):
        last = self.stack.count() - 1
        self.btn_back.setVisible(1 <= idx <= 4)
        self.btn_back.setEnabled(idx != 5)
        self.btn_next.setVisible(idx <= 4)
        self.btn_next.setText("Siguiente")
        if idx == 4:
            self.btn_next.setText("Instalar")
        if idx == 5:
            self.btn_reboot.setEnabled(False)

    def next(self):
        idx = self.stack.currentIndex()
        if idx == 0 and not self._validate_welcome():
            return
        if idx == 1:
            if not self._validate_disk():
                return
            self.stack.setCurrentIndex(2)
            return
        if idx == 2:
            if not self._validate_users():
                return
            self.stack.setCurrentIndex(3)
            return
        if idx == 3:
            if not self._validate_extras():
                return
            self.opts_to_summary()
            self.stack.setCurrentIndex(4)
            return
        if idx == 4 and self._validate_disk():
            self.stack.setCurrentIndex(5)
            self._start_install()
            return
        self.stack.setCurrentIndex(idx + 1)

    def _validate_extras(self):
        if self.chk_encrypt.isChecked():
            if len(self.luks_pass.text()) < 8:
                QtWidgets.QMessageBox.warning(
                    self, "Contraseña de cifrado",
                    "Completá la contraseña del disco cifrado "
                    "(al menos 8 caracteres).")
                return False
        if (self.chk_snapper.isChecked()
                and self.fs_combo.currentText() != "btrfs"):
            QtWidgets.QMessageBox.warning(
                self, "Snapshots",
                "Snapper solo funciona con btrfs. "
                "Cambiá el sistema de archivos o desactivá esta opción.")
            return False
        return True

    def back(self):
        idx = self.stack.currentIndex()
        if idx > 0:
            self.stack.setCurrentIndex(idx - 1)

    def _validate_welcome(self):
        return True

    def _validate_disk(self):
        if self.disk_combo.count() == 0:
            self.disk_status.setText("No hay discos disponibles.")
            return False
        data = self.disk_combo.currentData()
        if disk_mounted(os.path.basename(data)):
            self.disk_status.setText(
                "Este disco está en uso (es posible que sea el USB live). "
                "Elegí otro.")
            return False
        if self.swap_chk.isChecked():
            size_b = run(["lsblk", "-bno", "SIZE", data], check=False
                         ).strip().splitlines()
            try:
                size_g = int(size_b[0]) / 1024 ** 3
            except (ValueError, IndexError):
                size_g = 0
            if self.swap_size.value() >= size_g:
                self.disk_status.setText(
                    "El swap es mayor o igual que el tamaño del disco. "
                    "Reducilo o quitá la swap.")
                return False
        self.disk_status.setText("")
        return True

    def _validate_users(self):
        host = self.hostname.text().strip()
        user = self.username.text().strip()
        pw1 = self.passwd.text()
        pw2 = self.passwd2.text()
        rpw = self.root_passwd.text()
        if not host or not user:
            QtWidgets.QMessageBox.warning(self, "Faltan datos",
                                          "Completá nombre de equipo y usuario.")
            return False
        if not re.match(r"^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$", host):
            QtWidgets.QMessageBox.warning(
                self, "Nombre de equipo inválido",
                "Usá solo letras, números y guiones (sin espacios).")
            return False
        if not re.match(r"^[a-z_][a-z0-9_-]{0,31}$", user):
            QtWidgets.QMessageBox.warning(
                self, "Usuario inválido",
                "Usá minúsculas, números y guiones bajos (letra inicial).")
            return False
        if len(pw1) < 4:
            QtWidgets.QMessageBox.warning(self, "Contraseña corta",
                                          "Usá al menos 4 caracteres.")
            return False
        if pw1 != pw2:
            QtWidgets.QMessageBox.warning(self, "Contraseñas distintas",
                                          "Las contraseñas no coinciden.")
            return False
        if len(rpw) < 4:
            QtWidgets.QMessageBox.warning(self, "Contraseña de root corta",
                                          "Usá al menos 4 caracteres para root.")
            return False
        return True

    def opts_to_summary(self):
        disk = self.disk_combo.currentData()
        swap = self.swap_size.value() if self.swap_chk.isChecked() else 0
        txt = (
            f"Disco:                 {disk}\n"
            f"Swap:                  {swap} GiB\n" if swap else
            f"Disco:                 {disk}\nSwap:                  no\n"
        )
        txt += (
            f"Sistema:               {'UEFI' if is_uefi() else 'BIOS'}\n"
            f"Fs raíz:               {self.fs_combo.currentText()}\n"
            f"Hostname:              {self.hostname.text()}\n"
            f"Usuario:               {self.username.text()}\n"
            f"Teclado:               {self.kbd.currentText()}\n"
            f"Zona horaria:          {self.tz.currentText()}\n"
            f"Idioma:                {self.locale.currentText()}\n"
            f"Layout:                {self.layout_combo.currentText().split('—')[0].strip()}"
        )
        extras = []
        if self.chk_encrypt.isChecked():
            extras.append("Cifrado LUKS")
        if self.chk_firewall.isChecked():
            extras.append("Firewall")
        if self.chk_octopi.isChecked():
            extras.append("Octopi")
        if self.chk_plymouth.isChecked():
            extras.append("Plymouth")
        if self.chk_snapper.isChecked():
            extras.append("Snapper")
        if self.chk_updates.isChecked():
            extras.append("Actualizaciones")
        txt += "\nExtras:                " + (", ".join(extras) or "ninguno")
        self.summary.setPlainText(txt)

    def _start_install(self):
        self._opts = {
            "disk": self.disk_combo.currentData(),
            "filesystem": self.fs_combo.currentText(),
            "swap": self.swap_size.value() if self.swap_chk.isChecked() else 0,
            "keyboard": self.kbd.currentText(),
            "timezone": self.tz.currentText(),
            "locale": self.locale.currentText(),
            "hostname": self.hostname.text().strip(),
            "username": self.username.text().strip(),
            "fullname": self.fullname.text().strip() or "UTN User",
            "password": self.passwd.text(),
            "root_password": self.root_passwd.text(),
            "layout": self.layout_combo.currentData(),
            "encrypt": self.chk_encrypt.isChecked(),
            "luks_passphrase": self.luks_pass.text(),
            "firewall": self.chk_firewall.isChecked(),
            "octopi": self.chk_octopi.isChecked(),
            "plymouth": self.chk_plymouth.isChecked(),
            "snapper": self.chk_snapper.isChecked(),
            "updates": self.chk_updates.isChecked(),
        }
        self.btn_next.setEnabled(False)
        self.btn_back.setEnabled(False)
        self.log_view.clear()
        self.bar.setValue(0)
        self._worker = InstallWorker(self._opts)
        self._worker.log.connect(self.log_view.appendPlainText)
        self._worker.progress.connect(self.bar.setValue)
        self._worker.done.connect(self._install_done)
        self._worker.start()

    def _install_done(self, ok, msg):
        self.bar.setValue(100 if ok else self.bar.value())
        if ok:
            self.stack.setCurrentIndex(6)
            self.finish_msg.setText(msg)
        else:
            QtWidgets.QMessageBox.critical(self, "Error de instalación",
                                           f"{msg}\n\nRevisá el log.")
            self.btn_next.setEnabled(True)
            self.btn_back.setEnabled(True)


def main():
    if os.geteuid() != 0:
        print("El instalador debe ejecutarse como root.", file=sys.stderr)
        sys.exit(1)
    app = QtWidgets.QApplication(sys.argv)
    app.setWindowIcon(QtWidgets.QIcon(LOGO))
    scale = ui_scale()
    font = app.font()
    font.setPointSizeF(14 * scale)
    app.setFont(font)
    app.setStyleSheet(ui_stylesheet(scale))
    w = InstallerWindow(scale)
    w.showMaximized()
    sys.exit(app.exec_())


if __name__ == "__main__":
    main()