    def _refresh_disks(self):
        self.disk_combo.clear()
        for d in disks():
            label = f"/dev/{d['name']}  ({d['size']} {d.get('model','') or ''})"
            self.disk_combo.addItem(label.strip(), f"/dev/{d['name']}")

    def _build_users(self):
        page = QtWidgets.QWidget()
        form = QtWidgets.QFormLayout(page)
        title = QtWidgets.QLabel("Datos de usuario")
        title.setStyleSheet(
            f"font-size:{20 * self.scale:.0f}px; font-weight:bold;")
