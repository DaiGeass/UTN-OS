        form.addRow("Nombre de usuario:", self.username)
        self.fullname = QtWidgets.QLineEdit("UTN User")
        form.addRow("Nombre completo:", self.fullname)
        self.passwd = QtWidgets.QLineEdit()
        self.passwd.setEchoMode(QtWidgets.QLineEdit.Password)
        form.addRow("Contraseña del usuario:", self.passwd)
        self.passwd2 = QtWidgets.QLineEdit()
        self.passwd2.setEchoMode(QtWidgets.QLineEdit.Password)
        form.addRow("Confirmar contraseña:", self.passwd2)
        self.root_passwd = QtWidgets.QLineEdit()
        self.root_passwd.setEchoMode(QtWidgets.QLineEdit.Password)
        form.addRow("Contraseña de root:", self.root_passwd)

        form.addRow(QtWidgets.QLabel(""))
        form.addRow(QtWidgets.QLabel("Apariencia del escritorio instalado:"))

        layout_row = QtWidgets.QHBoxLayout()
        self.layout_combo = QtWidgets.QComboBox()
        self.layout_combo.setMinimumWidth(int(360 * self.scale))
        self._layouts = discover_layouts()
        for i, d in enumerate(self._layouts):
            self.layout_combo.addItem(f"{d['display']}  —  {d['description']}",
                                      d["id"])
            self.layout_combo.setItemData(
                i, d["description"], QtCore.Qt.ToolTipRole)
            if d["default"]:
                self.layout_combo.setCurrentIndex(i)
        self.layout_combo.currentIndexChanged.connect(
            self._set_layout_preview)
        layout_row.addWidget(self.layout_combo, 1)

        self.layout_preview = QtWidgets.QLabel()
        self.layout_preview.setFixedSize(int(240 * self.scale),
                                         int(135 * self.scale))
        self.layout_preview.setAlignment(QtCore.Qt.AlignCenter)
        self.layout_preview.setFrameShape(QtWidgets.QFrame.Box)
        layout_row.addWidget(self.layout_preview)
        form.addRow("Layout:", layout_row)
        self._set_layout_preview()
        self._add_page(page)

    def _wallpaper_path(self, code):
        base = os.path.join(LAYOUT_DIR, code or "")
        for ext in ("wallpaper.svg", "wallpaper.png", "wallpaper.jpg",
                    "wallpaper.jpeg"):
            f = os.path.join(base, ext)
            if os.path.isfile(f):
                return f
        return None

    def _set_layout_preview(self, *_):
        code = self.layout_combo.currentData()
        path = self._wallpaper_path(code)
        pix = None
        if path and path.endswith(".svg"):
            try:
                from PyQt5 import QtSvg
                renderer = QtSvg.QSvgRenderer(path)
                vb = renderer.viewBoxF()
                w, h = int(vb.width()), int(vb.height())
                if w <= 0 or h <= 0:
                    raise ValueError
                pm = QtGui.QPixmap(int(w), int(h))
                pm.fill(QtCore.Qt.transparent)
                painter = QtGui.QPainter(pm)
                renderer.render(painter)
                painter.end()
                pix = pm
            except Exception:
                pix = None
        elif path:
            pix = QtGui.QPixmap(path)
        if pix and not pix.isNull():
            self.layout_preview.setPixmap(pix.scaled(
                self.layout_preview.size(), QtCore.Qt.KeepAspectRatio,
                QtCore.Qt.SmoothTransformation))
        else:
            self.layout_preview.setText("(sin preview)")

    def _build_extras(self):
        page = QtWidgets.QWidget()
        v = QtWidgets.QVBoxLayout(page)
        title = QtWidgets.QLabel("Opcionales (podés desactivarlos)")
        title.setStyleSheet(
            f"font-size:{20 * self.scale:.0f}px; font-weight:bold;")
        v.addWidget(title)
        v.addWidget(QtWidgets.QLabel(
            "Los que requieren internet se descargarán durante la instalación."))
        v.addSpacing(8)

        def make_chk(text, default=True, hint=""):
            c = QtWidgets.QCheckBox(text)
            c.setChecked(default)
            if hint:
                c.setToolTip(hint)
            v.addWidget(c)
            return c

        self.chk_encrypt = make_chk(
            "Cifrar disco con LUKS (pide contraseña al arrancar)",
            False, "Cifra toda la partición del sistema.")
        self.luks_pass = QtWidgets.QLineEdit()
        self.luks_pass.setPlaceholderText(
            "Contraseña del disco cifrado (al menos 8 caracteres)")
        self.luks_pass.setEchoMode(QtWidgets.QLineEdit.Password)
        self.luks_pass.setEnabled(False)
        self.chk_encrypt.toggled.connect(self.luks_pass.setEnabled)
        v.addWidget(self.luks_pass)

        self.chk_firewall = make_chk(
            "Activar firewall (nftables: bloquea entradas, permite salidas)",
            True, "Reglas simples de firewall incluidas en el sistema.")
        self.chk_octopi = make_chk(
            "Instalar centro de paquetes gráfico (Octopi)",
            True, "Requiere internet. Octopi usa el repositorio de Arch.")
        self.chk_plymouth = make_chk(
