#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Instalador gráfico de UTN OS (estilo asistente).

Pasos: bienvenida/teclado -> disco -> usuarios -> resumen -> instalación -> fin.
Corre como root en el live y copia el sistema live al disco de destino.
"""
import json
import os
import re
import shlex
import subprocess
import sys
import time

from PyQt5 import QtCore, QtGui, QtWidgets

sys.path.insert(0, "/usr/share/utn-os")
import utn_theme as UT

LOGO = "/usr/share/pixmaps/utn-os.png"

MOUNT = "/mnt/utnroot"
LIVE_SFS = "/run/archiso/bootmnt/arch/x86_64/airootfs.sfs"

LAYOUT_DIR = "/usr/share/utn-os/layouts"
TIMEZONES = [
    "America/Argentina/Buenos_Aires",
    "America/Mexico_City",
    "America/Monterrey",
    "America/Bogota",
    "America/Caracas",
    "America/Lima",
    "America/Santiago",
    "America/Sao_Paulo",
    "Europe/Madrid",
]
KEYBOARDS = ["es", "latam", "us", "br", "fr", "de", "pt", "it", "uk"]
LOCALES = ["es_MX.UTF-8", "es_AR.UTF-8", "es_ES.UTF-8", "en_US.UTF-8",
           "pt_BR.UTF-8", "fr_FR.UTF-8", "de_DE.UTF-8", "it_IT.UTF-8"]
CONSOLE_KEYMAP = {
    "es": "es", "latam": "us", "us": "us", "br": "br-abnt2", "fr": "fr",
    "de": "de", "pt": "pt-latin1", "it": "it", "uk": "uk",
}
FILESYSTEMS = ["ext4", "btrfs", "xfs", "jfs", "f2fs"]
def ui_stylesheet(scale=1.0):
    """Hoja de estilos compartida (verde+azul, claro/oscuro)."""
    return UT.stylesheet(UT.current_theme(), scale)


def ui_scale():
    """Factor de escala para pantallas grandes (p.ej. 4K o ultrawide)."""
    return UT.ui_scale()


def run(cmd, check=True, timeout=900):
    """Ejecuta un comando y devuelve la salida. Log a la consola."""
    p = subprocess.Popen(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
    )
    out, _ = p.communicate(timeout=timeout)
    if check and p.returncode != 0:
        raise RuntimeError(f"Fallo: {' '.join(cmd)}\n{out}")
    return out


def is_uefi():
    return os.path.isdir("/sys/firmware/efi")


def discover_layouts():
    """Lista los layouts disponibles desde /usr/share/utn-os/layouts (meta.toml)."""
    try:
        out = run(["utn-layouts"], check=False)
        data = json.loads(out)
        if isinstance(data, list):
            return data
    except (json.JSONDecodeError, OSError):
        pass
    if os.path.isdir(LAYOUT_DIR):
        return [{"id": d, "display": d, "description": "", "default": False}
                for d in sorted(os.listdir(LAYOUT_DIR))]
    return []


def disks():
    """"Lista de discos (sata, nvme, virtio), sin loop/ram/rom."""
    out = run(["lsblk", "-J", "-o", "NAME,SIZE,MODEL,TYPE,TRAN"], check=False)
    try:
        data = json.loads(out)
    except json.JSONDecodeError:
        return []
    devs = []
    for d in data.get("blockdevices", []):
        name = d.get("name", "")
        if (d.get("type") == "disk"
                and re.match(r"^(sd|hd|vd|nvme)", name)):
            devs.append(d)
    return devs


def disk_mounted(name):
    """True si algún fs del disco está montado (protege el live/USB)."""
    out = run(["lsblk", "-lno", "MOUNTPOINT", f"/dev/{name}"], check=False)
    return any(mp.strip() for mp in out.splitlines() if mp.strip())


class InstallWorker(QtCore.QThread):
    log = QtCore.pyqtSignal(str)
    progress = QtCore.pyqtSignal(int)
    done = QtCore.pyqtSignal(bool, str)

    def __init__(self, opts, parent=None):
        super().__init__(parent)
        self.opts = opts

    def _log(self, msg, progress=None):
        self.log.emit(msg)
        if progress is not None:
            self.progress.emit(progress)

    def run(self):
        try:
            self.install()
            self.done.emit(True, "Instalación completada. Presioná Reiniciar.")
        except Exception as exc:
            self._log(f"\n[ERROR] {exc}")
            self.done.emit(False, str(exc))

    # ---------------------------------------------------------------- steps
    def _parted_bios(self, disk):
        run(["parted", "-s", disk, "mklabel", "msdos"])
        swap = self.opts["swap"]
        if swap:
            run(["parted", "-s", disk, "mkpart", "primary", "ext4",
                 "1MiB", f"-{swap}GiB"])
            run(["parted", "-s", disk, "set", "1", "boot", "on"])
            run(["parted", "-s", disk, "mkpart", "primary", "linux-swap",
                 f"-{swap}GiB", "100%"])
        else:
            run(["parted", "-s", disk, "mkpart", "primary", "ext4",
                 "1MiB", "100%"])
            run(["parted", "-s", disk, "set", "1", "boot", "on"])

    def _sgdisk_uefi(self, disk):
        run(["sgdisk", "--zap-all", disk])
        run(["sgdisk", "--clear", disk])
        run(["sgdisk", "-n", "1:0:+512M", "-t", "1:ef00", "-c", "1:EFI", disk])
        swap = self.opts["swap"]
        if swap:
            run(["sgdisk", "-n", "2:0:-{}G".format(swap), "-t", "2:8304",
                 "-c", "2:ROOT", disk])
            run(["sgdisk", "-n", "3:0:0", "-t", "3:8200", "-c", "3:SWAP",
                 disk])
        else:
            run(["sgdisk", "-n", "2:0:0", "-t", "2:8304", "-c", "2:ROOT",
                 disk])

    def _wait_partitions(self, disk, count):
        run(["partprobe", disk])
        base = os.path.basename(disk)
        for _ in range(20):
            parts = run(["lsblk", "-lno", "NAME", disk], check=False)
            names = [p.strip() for p in parts.splitlines() if p.strip()]
            if len(names) >= count + 1:
                return names[1:]
            time.sleep(0.5)
        raise RuntimeError("No se reconocieron las particiones creadas")

    def install(self):
        opts = self.opts
        disk = opts["disk"]
        fs = opts["filesystem"]
        swap = opts["swap"]

        self._log("==" * 30)
        self._log("   INSTALL UTNOS  -  by DaiGeass/ZZERO")
        self._log("==" * 30)
        self._log(f"Sistema: {'UEFI' if is_uefi() else 'BIOS'}")
        self._log(f"Disco:   {disk}")
        self._log(f"Sistema de archivos raíz: {fs}")
        self._log(f"Swap:    {swap} GiB" if swap else "Swap: no")

        steps = [
            ("Particionando disco", 8),
            ("Formateando particiones", 18),
            ("Montando particiones", 22),
            ("Copiando sistema (rsync)", 65),
            ("Configurando sistema", 88),
            ("Instalando GRUB", 97),
        ]
        for name, pct in steps:
            self._log(f"\n== {name} ==")
            self.progress.emit(pct)

        if self._partition(disk, fs, swap):
            self._format(disk, fs, swap)
            self._mount(disk)
            self._copy_system()
            self._configure(disk)
            self._grub(disk)
        self.progress.emit(100)

    def _partition(self, disk, fs, swap):
        if is_uefi():
            self._sgdisk_uefi(disk)
        else:
            self._parted_bios(disk)

        expected = (2 if is_uefi() else 1) + (1 if swap else 0)
        parts = self._wait_partitions(disk, expected)
        if len(parts) < expected:
            raise RuntimeError("Particionado falló")
        self.opts["parts"] = [f"/dev/{p}" for p in parts]
        self._log(f"Particiones: {', '.join(self.opts['parts'])}")
        return True

    def _format(self, disk, fs, swap):
        parts = self.opts["parts"]
        if is_uefi():
            efi, rootish = parts[0], parts[1]
            root = rootish
            run(["mkfs.vfat", "-F32", "-n", "EFI", efi])
            self._log(f"  EFI  {efi}  (vfat)")
        else:
            root = parts[0]
        # Cifrado LUKS opcional: formateamos la partición y abrimos el mapper
        encrypt = self.opts.get("encrypt")
        if encrypt:
            keyfile = "/tmp/utn-luks.key"
            with open(keyfile, "w") as fh:
                fh.write(self.opts.get("luks_passphrase", ""))
            os.chmod(keyfile, 0o600)
            luks_uuid = None
            run(["cryptsetup", "-q", "--type=luks2", "luksFormat",
                 "--key-file", keyfile, root])
            try:
                out = run(["blkid", "-s", "UUID", "-o", "value", root],
                          check=False).strip()
                luks_uuid = out.splitlines()[0] if out else None
            except Exception:
                luks_uuid = None
            run(["cryptsetup", "open", "--key-file", keyfile, root, "utnroot"])
            os.remove(keyfile)
            self.opts["luks_uuid"] = luks_uuid
            self._log(f"  LUKS  {root}  -> /dev/mapper/utnroot")
            root = "/dev/mapper/utnroot"
        self.opts["root_dev"] = root
        mkfs = {
            "ext4": ["mkfs.ext4", "-F", "-L", "UTNROOT", root],
            "btrfs": ["mkfs.btrfs", "-f", "-L", "UTNROOT", root],
            "xfs": ["mkfs.xfs", "-f", "-L", "UTNROOT", root],
            "jfs": ["mkfs.jfs", "-q", "-L", "UTNROOT", root],
            "f2fs": ["mkfs.f2fs", "-f", "-l", "UTNROOT", root],
        }[fs]
        self._log(f"  ROOT {root}  ({fs})")
        run(mkfs)
        if swap:
            run(["mkswap", "-L", "swap", parts[-1]])
            self._log(f"  SWAP {parts[-1]}")

    def _mount(self, disk):
        parts = self.opts["parts"]
        os.makedirs(MOUNT, exist_ok=True)
        root = self.opts["root_dev"]
        if is_uefi():
            efi = parts[0]
        else:
            efi = None
        run(["mount", root, MOUNT])
        if efi:
            os.makedirs(f"{MOUNT}/boot/efi", exist_ok=True)
            run(["mount", efi, f"{MOUNT}/boot/efi"])
        if self.opts["swap"]:
            run(["swapon", parts[-1]], check=False)
        self._log(f"  Montado {root} en {MOUNT}")

    def _copy_system(self):
        excludes = [
            "/dev", "/proc", "/sys", "/run", "/tmp", "/mnt",
            "/media", "/lost+found", "/var/cache/pacman/pkg",
            "/etc/machine-id", "/etc/hostname", "/etc/fstab",
            "/.wh.*", "/etc/xdg/autostart/utn-welcome.desktop",
            "/etc/xdg/autostart/utn-installer.desktop",
            "/usr/local/bin/utn-installer-live",
            "/usr/local/bin/utn-welcome",
        ]
        cmd = ["rsync", "-aHAXx", "--info=progress2", "--no-i-r", "--stats"]
        for ex in excludes:
            cmd.append(f"--exclude={ex}")
        cmd += ["/", f"{MOUNT}/"]
        self._log("  Copiando sistema raíz (puede tardar unos minutos)...")
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                             stderr=subprocess.STDOUT, text=True)
        buf = ""
        last = 0.0
        while True:
            chunk = p.stdout.read(4096)
            if not chunk:
                break
            buf += chunk
            while "\n" in buf or "\r" in buf:
                line, _, buf = re.split(r"[\r\n]", buf, maxsplit=1)
                line = line.strip()
                if not line:
                    continue
                m = re.search(r"(\d+(\.\d+)?)%", line)
                if m and float(m.group(1)) < 100:
                    if time.time() - last > 0.5:
                        self.progress.emit(65 + int(float(m.group(1)) / 100 * 20))
                        last = time.time()
                elif m:
                    self.progress.emit(85)
                else:
                    self._log(line)
            time.sleep(0.05)
        p.wait()
        if p.returncode != 0:
            raise RuntimeError("rsync falló al copiar el sistema")
        self.progress.emit(87)
        self._log("  Copia del sistema finalizada")

    def _configure(self, disk):
        opt = self.opts
        q = lambda s: shlex.quote(str(s))
        locale = opt["locale"]
        console = CONSOLE_KEYMAP.get(opt["keyboard"], "us")
        encrypt = opt.get("encrypt")
        firewall = opt.get("firewall")
        octopi = opt.get("octopi")
        plymouth = opt.get("plymouth")
        snapper = opt.get("snapper")
        updates = opt.get("updates")

        # HOOKS de mkinitcpio según opciones elegidas
        hooks = ["base", "udev", "autodetect", "microcode", "modconf", "kms",
                 "keyboard", "keymap", "consolefont", "block"]
        if plymouth:
            hooks.append("plymouth")
        if encrypt:
            hooks.append("encrypt")
        hooks += ["filesystems", "fsck"]
        HOOKS = " ".join(hooks)

        extras = []
        if firewall:
            extras.append("""# firewall (nftables)
cat > /etc/nftables.conf <<'NFT'
table inet filter {
  chain input { type filter hook input priority filter; policy drop;
    ct state established,related accept
    iif "lo" accept
    ip protocol icmp limit rate 5/second burst 10 packets accept
  }
  chain forward { type filter hook forward priority filter; policy drop; }
  chain output { type filter hook output priority filter; policy accept; }
}
NFT
systemctl enable nftables
echo '  Firewall nftables activado'""")
        if octopi:
            extras.append("""echo '  Instalando gestor de paquetes (octopi)...'
pacman -S --noconfirm octopi >/dev/null 2>&1 && echo '    octopi instalado' || echo '    octopi no disponible (sin internet?)'
systemctl --force --now enable reflector.timer >/dev/null 2>&1 || true""")
        if plymouth:
            extras.append("""echo '  Instalando pantalla de arranque (plymouth)...'
pacman -S --noconfirm plymouth >/dev/null 2>&1 && {
  sed -i 's/^#*Theme=.*/Theme=solar/' /etc/plymouth/plymouthd.conf 2>/dev/null || true
  echo '    plymouth instalado'
} || echo '    plymouth no disponible (sin internet?)'""")
        if snapper:
            extras.append("""echo '  Configurando snapshots btrfs (snapper)...'
pacman -S --noconfirm snapper >/dev/null 2>&1 && {
  snapper -c root create-config / >/dev/null 2>&1 || true
  systemctl enable snapper-timeline.timer snapper-cleanup.timer >/dev/null 2>&1 || true
  echo '    snapper activo'
} || echo '    snapper no disponible (sin internet?)'""")
        EXTRA_BLOCK = "\n".join(extras)

        script = f"""#!/bin/bash
set -e
echo '== Configurando sistema =='

# zona horaria
ln -sf /usr/share/zoneinfo/{opt['timezone']} /etc/localtime

# hostname
printf '%s\\n' {q(opt['hostname'])} > /etc/hostname

# locale
grep -q '^{locale} UTF-8' /etc/locale.gen \\
    && sed -i 's/^#\\?{locale} UTF-8/{locale} UTF-8/' /etc/locale.gen \\
    || echo '{locale} UTF-8' >> /etc/locale.gen
locale-gen >/dev/null 2>&1 || true
printf 'LANG={locale}\\n' > /etc/locale.conf

# teclado (consola + X11)
printf 'KEYMAP={console}\\n' > /etc/vconsole.conf
mkdir -p /etc/X11/xorg.conf.d
cat > /etc/X11/xorg.conf.d/00-keyboard.conf <<XEOF
Section "InputClass"
    Identifier "keyboard-layout"
    MatchIsKeyboard "on"
    Option "XkbLayout" "{opt['keyboard']}"
EndSection
XEOF

# usuarios (passwords provienen de /tmp/chpasswd.in, sin exponer en el log)
if ! id -u {q(opt['username'])} >/dev/null 2>&1; then
    useradd -m -G wheel,users,audio,video,storage,lp,network,power \\
        -s /bin/bash -c {q(opt['fullname'])} {q(opt['username'])}
fi
chpasswd < /tmp/chpasswd.in
rm -f /tmp/chpasswd.in
mkdir -p /etc/sudoers.d
printf '%s ALL=(ALL) ALL\\n' {q(opt['username'])} > "/etc/sudoers.d/10-{opt['username']}"
chmod 440 "/etc/sudoers.d/10-{opt['username']}"

# autologin + sesión LXQt
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/autologin.conf <<XEOF
[Autologin]
User={opt['username']}
Session=lxqt
XEOF

# layout de escritorio elegido como default de /etc/xdg
LAYOUT=/usr/share/utn-os/layouts/{opt['layout']}
for f in panel.conf lxqt.conf; do
    install -Dm644 "$LAYOUT/lxqt/$f" "/etc/xdg/lxqt/$f"
done
install -Dm644 "$LAYOUT/openbox/rc.xml" /etc/xdg/openbox/rc.xml
install -Dm644 "$LAYOUT/pcmanfm/settings.conf" /etc/xdg/pcmanfm/lxqt/settings.conf
if [ -f "$LAYOUT/picom.conf" ]; then
    install -Dm644 "$LAYOUT/picom.conf" /etc/xdg/picom.conf
fi

# ====== extras opcionales elegidos en la instalación ======
{EXTRA_BLOCK}

# limpiar config live y regenerar initramfs estándar
rm -rf /etc/mkinitcpio.conf.d /etc/mkinitcpio.d
rm -rf /etc/systemd/system/getty@tty1.service.d
rm -f /root/.ssh/authorized_keys
rm -f /etc/ssh/sshd_config.d/99-utn-debug.conf
sed -i 's/^HOOKS=(.*)/HOOKS=({HOOKS})/' /etc/mkinitcpio.conf
sed -i 's/^#COMPRESSION=.*/COMPRESSION="zstd"/' /etc/mkinitcpio.conf
sed -i 's/^#MODULES=.*/MODULES=()/' /etc/mkinitcpio.conf
mkdir -p /etc/mkinitcpio.d
cat > /etc/mkinitcpio.d/linux.preset <<XEOF
PRESETS=('default' 'fallback')
ALL_kver='/boot/vmlinuz-linux'
default_config='/etc/mkinitcpio.conf'
default_image="/boot/initramfs-linux.img"
fallback_config='/etc/mkinitcpio.conf'
fallback_image="/boot/initramfs-linux-fallback.img"
fallback_options='-S autodetect'
XEOF
mkinitcpio -P >/dev/null 2>&1 || true

# servicios
systemctl enable NetworkManager sddm >/dev/null 2>&1 || true
{"systemctl enable plymouth-start plymouth-quit plymouth-quit-wait >/dev/null 2>&1 || true" if plymouth else ""}
{"systemctl enable nftables >/dev/null 2>&1 || true" if firewall else ""}
{"systemctl enable snapper-timeline.timer snapper-cleanup.timer >/dev/null 2>&1 || true" if snapper else ""}
{"echo 'Descargando e instalando actualizaciones (puede tardar)...' && pacman -Syu --noconfirm >/dev/null 2>&1 && mkinitcpio -P >/dev/null 2>&1 || true" if updates else ""}

# fstab ya fue generado desde el host (genfstab -U)
echo '== Fin de configuración =='
"""
        with open(f"{MOUNT}/tmp/chpasswd.in", "w") as fh:
            fh.write(f"{opt['username']}:{opt['password']}\n")
            fh.write(f"root:{opt['root_password']}\n")
        os.chmod(f"{MOUNT}/tmp/chpasswd.in", 0o600)

        # crypttab para arranque con disco cifrado (LUKS)
        if encrypt and opt.get("luks_uuid"):
            with open(f"{MOUNT}/etc/crypttab", "w") as fh:
                fh.write(f"utnroot UUID={opt['luks_uuid']} none luks\n")
            self._log(f"  Crypttab: utnroot UUID={opt['luks_uuid']}")

        with open(f"{MOUNT}/tmp/setup.sh", "w") as fh:
            fh.write(script)
        os.chmod(f"{MOUNT}/tmp/setup.sh", 0o700)

        # genfstab se corre desde el host (en root del target)
        fstab = subprocess.run(
            ["genfstab", "-U", MOUNT], capture_output=True, text=True
        ).stdout
        with open(f"{MOUNT}/etc/fstab", "w") as fh:
            fh.write(fstab)
        self._log("  Fstab generado: " + " | ".join(fstab.splitlines()[:4]))

        run(["arch-chroot", MOUNT, "/bin/bash", "/tmp/setup.sh"])
        run(["rm", "-f", f"{MOUNT}/tmp/setup.sh", f"{MOUNT}/tmp/chpasswd.in"])
        self._log("  Configuración aplicada")
        self._log(f"  Usuario: {opt['username']}  |  Locale: {opt['locale']}")
        self._log(f"  Teclado consola: {console}  |  X11: {opt['keyboard']}")
        self._log("  Extras: " + ", ".join(
            k for k in ("encrypt", "firewall", "octopi", "plymouth",
                        "snapper", "updates") if opt.get(k)) or "ninguno")

    def _grub(self, disk):
        boot_id = "UTN_OS"
        opt = self.opts
        if opt.get("encrypt") and opt.get("luks_uuid"):
            crypt_device = (f'GRUB_CMDLINE_LINUX='
                            f'"cryptdevice=UUID={opt["luks_uuid"]}:utnroot"')
            cryptodisk = 'GRUB_ENABLE_CRYPTODISK=y'
        else:
            crypt_device = 'GRUB_CMDLINE_LINUX=""'
            cryptodisk = '#GRUB_ENABLE_CRYPTODISK'
        run(["arch-chroot", MOUNT, "/bin/bash", "-c",
             "printf '%s\\n' "
             "'GRUB_DEFAULT=0' "
             "'GRUB_TIMEOUT=5' "
             "'GRUB_DISTRIBUTOR=\"UTN OS\"' "
             f"'{crypt_device}' "
             f"'{cryptodisk}' "
             "'GRUB_BACKGROUND=/boot/grub/utn-splash.png' "
             "'GRUB_GFXMODE=1024x768,800x600,auto' "
             "'GRUB_DISABLE_OS_PROBER=false' "
             "> /etc/default/grub"])
        if is_uefi():
            run(["arch-chroot", MOUNT, "grub-install",
                 "--target=x86_64-efi", "--efi-directory=/boot/efi",
                 f"--bootloader-id={boot_id}", "--recheck"])
        else:
            run(["arch-chroot", MOUNT, "grub-install",
                 "--target=i386-pc", "--recheck", disk])
        run(["arch-chroot", MOUNT, "/bin/bash", "-c",
             "mkdir -p /boot/grub && cp /usr/share/utn-os/splash.png "
             "/boot/grub/utn-splash.png"])
        run(["arch-chroot", MOUNT, "grub-mkconfig", "-o",
             "/boot/grub/grub.cfg"])
        run(["umount", "-R", MOUNT])
        if opt.get("encrypt"):
            run(["cryptsetup", "-q", "close", "utnroot"], check=False)
        self._log("  GRUB instalado")


class InstallerWindow(QtWidgets.QWidget):
    def __init__(self, scale=1.0):
        super().__init__()
        self.scale = scale
        self._worker = None
        self._opts = {}
        self.setWindowTitle("INSTALL UTNOS by DaiGeass/ZZERO")
        self.setMinimumSize(int(760 * scale), int(560 * scale))
        self.layout = QtWidgets.QVBoxLayout(self)

        self.stack = QtWidgets.QStackedWidget(self)
        self.layout.addWidget(self.stack)

        self._build_welcome()
        self._build_disk()
        self._build_users()
        self._build_extras()
        self._build_summary()
        self._build_install()
        self._build_finish()

        self.buttons = QtWidgets.QHBoxLayout()
        self.btn_back = QtWidgets.QPushButton("Atrás")
        self.btn_next = QtWidgets.QPushButton("Siguiente")
        self.btn_next.setDefault(True)
        self.btn_back.clicked.connect(self.back)
        self.btn_next.clicked.connect(self.next)
        self.buttons.addStretch(1)
        self.buttons.addWidget(self.btn_back)
        self.buttons.addWidget(self.btn_next)
        self.layout.addLayout(self.buttons)

        self.stack.currentChanged.connect(self._page_changed)
        self.stack.setCurrentIndex(0)

    # ---------------------------------------------------------------- pages
    def _add_page(self, widget):
        self.stack.addWidget(widget)

    def _build_welcome(self):
        page = QtWidgets.QWidget()
        v = QtWidgets.QVBoxLayout(page)
        title = QtWidgets.QLabel(
