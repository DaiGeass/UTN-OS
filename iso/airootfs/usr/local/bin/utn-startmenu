def panel_position(layout):
    path = LAYOUTS / layout / "lxqt/panel.conf"
    config = configparser.ConfigParser(interpolation=None)
    config.read(path)
    if "General" not in config:
        return "Bottom", 40
    for name in (item.strip() for item in config["General"].get("panels", "").split(",")):
        if not name or name not in config:
            continue
        if "startmenu" in config[name].get("plugins", ""):
            return config[name].get("position", "Bottom"), config[name].getint("panelSize", 40)
    return "Bottom", 40


class Menu(QWidget):
    def __init__(self, layout):
        super().__init__(None, Qt.Popup | Qt.FramelessWindowHint | Qt.NoDropShadowWindowHint)
        self.setAttribute(Qt.WA_TranslucentBackground)
        self.layout_id = layout
        self.fullscreen = layout == "windows8"
        self.buttons = []
        title, subtitle, self.mode, self.power = CONFIGS[layout]
        self.title = title
        self.subtitle = subtitle
        self.setStyleSheet(STYLES[layout])
        self.build()
        self.place()

    def build(self):
        outer = QVBoxLayout(self)
        outer.setContentsMargins(0, 0, 0, 0)
        card = QFrame()
        card.setObjectName("card")
        outer.addWidget(card)
        body = QVBoxLayout(card)
        if self.fullscreen:
            body.setContentsMargins(80, 48, 120, 40)
            body.setSpacing(18)
        else:
            body.setContentsMargins(16, 14, 16, 14)
            body.setSpacing(9)

        header = QHBoxLayout()
        header.setSpacing(10)
        logo = QLabel()
        logo_path = ASSETS / "icons/utn-logo.png"
        if logo_path.is_file():
            logo_size = 56 if self.fullscreen else 40
            logo.setPixmap(QPixmap(str(logo_path)).scaled(logo_size, logo_size, Qt.KeepAspectRatio, Qt.SmoothTransformation))
        header.addWidget(logo)
        names = QVBoxLayout()
        names.setSpacing(0)
        title = QLabel(self.title)
        title.setObjectName("title")
        subtitle = QLabel(self.subtitle)
        subtitle.setObjectName("subtitle")
        names.addWidget(title)
        names.addWidget(subtitle)
        header.addLayout(names)
        header.addStretch(1)
        close = QPushButton("×")
        close.setObjectName("foot")
        close.setFixedSize(26, 26)
        close.clicked.connect(self.close)
        header.addWidget(close)
        body.addLayout(header)

        self.search = QLineEdit()
        self.search.setObjectName("search")
        self.search.setPlaceholderText("Buscar aplicaciones")
        self.search.textChanged.connect(self.filter)
        if self.fullscreen:
            search_row = QHBoxLayout()
            self.search.setFixedWidth(420)
            search_row.addWidget(self.search)
            search_row.addStretch(1)
            body.addLayout(search_row)
        else:
            body.addWidget(self.search)

        apps = list(APPS)
        if self.fullscreen:
            apps.append(("installer", "Instalar UTN OS", ["/usr/local/bin/utn-installer"]))

        if self.mode == "tiles":
            grid = QGridLayout()
            grid.setHorizontalSpacing(10 if self.fullscreen else 8)
            grid.setVerticalSpacing(10 if self.fullscreen else 8)
            for index, (kind, label, command) in enumerate(apps):
                button = self.app_button(kind, label, command, tile=True)
                grid.addWidget(button, index // 3, index % 3)
                self.buttons.append(button)
            if self.fullscreen:
                grid_host = QWidget()
                grid_host.setFixedWidth(500)
                grid_host.setLayout(grid)
                grid_row = QHBoxLayout()
                grid_row.addWidget(grid_host)
                grid_row.addStretch(1)
                body.addLayout(grid_row)
            else:
                body.addLayout(grid)
                self.setFixedSize(392, 438)
        else:
            app_list = QVBoxLayout()
            app_list.setSpacing(2)
            for kind, label, command in apps:
                button = self.app_button(kind, label, command, tile=False)
                app_list.addWidget(button)
                self.buttons.append(button)
            body.addLayout(app_list)
            self.setFixedSize(376, 462)

        body.addStretch(1)
        footer = QHBoxLayout()
        footer.setSpacing(6)
        if not self.fullscreen:
            install = QPushButton("Instalar UTN OS")
            install.setObjectName("foot")
            if logo_path.is_file():
                install.setIcon(QIcon(str(logo_path)))
                install.setIconSize(QSize(18, 18))
            install.clicked.connect(lambda: self.launch(["/usr/local/bin/utn-installer"]))
            footer.addWidget(install)
        else:
            session = QLabel("UTN OS · sesión live")
            session.setObjectName("subtitle")
            footer.addWidget(session)
        footer.addStretch(1)
        if self.power:
            off = QPushButton("Apagar")
            off.setObjectName("foot")
            off.clicked.connect(lambda: self.launch(["systemctl", "poweroff"]))
            footer.addWidget(off)
            restart = QPushButton("Reiniciar")
            restart.setObjectName("foot")
            restart.clicked.connect(lambda: self.launch(["systemctl", "reboot"]))
            footer.addWidget(restart)
        body.addLayout(footer)
        if self.fullscreen:
            self.charms = self.build_charms()
        self.search.setFocus()

    def build_charms(self):
        charms = QFrame(self)
        charms.setObjectName("charms")
        column = QVBoxLayout(charms)
        column.setContentsMargins(8, 120, 8, 26)
        column.setSpacing(8)

        def add_charm(icon_name, label, action):
            button = QToolButton(charms)
            button.setObjectName("charm")
            button.setToolButtonStyle(Qt.ToolButtonTextUnderIcon)
            button.setIcon(QIcon.fromTheme(icon_name))
            button.setIconSize(QSize(26, 26))
            button.setText(label)
            button.setFixedSize(76, 72)
            button.clicked.connect(action)
            column.addWidget(button, 0, Qt.AlignHCenter)

        add_charm("edit-find", "Buscar", self.focus_search)
        add_charm("folder", "Compartir", lambda: self.launch(["pcmanfm-qt", "--new-window", str(Path.home())]))
        add_charm("go-home", "Inicio", self.close)
        add_charm("computer", "Dispositivos", lambda: self.launch(["pcmanfm-qt", "--new-window", "/"]))
        add_charm("preferences-system", "Ajustes", lambda: self.launch(["lxqt-config"]))
        column.addStretch(1)
        add_charm("system-shutdown", "Apagar", lambda: self.launch(["systemctl", "poweroff"]))
        add_charm("view-refresh", "Reiniciar", lambda: self.launch(["systemctl", "reboot"]))
        return charms

    def focus_search(self):
        self.search.setFocus()
        self.search.selectAll()

    def app_button(self, kind, label, command, tile):
        name = NAMES.get(kind, {}).get(self.layout_id, label)
        button = QToolButton()
        button.setObjectName("app")
        button.setText(name)
        if kind == "installer":
            icon = ASSETS / "icons/utn-logo.png"
        else:
            icon = LAYOUTS / self.layout_id / "icons/apps" / f"{kind}.svg"
        if icon.is_file():
            button.setIcon(QIcon(str(icon)))
        if tile:
            button.setToolButtonStyle(Qt.ToolButtonTextUnderIcon)
            if self.fullscreen:
                normal, hover = TILE_COLORS.get(kind, ("#0078d7", "#2b93e6"))
                button.setStyleSheet(
                    "QToolButton#app { background: %s; border: 0; color: #ffffff; padding: 12px; font-size: 13px; }"
                    "QToolButton#app:hover { background: %s; border: 0; }" % (normal, hover)
                )
                button.setIconSize(QSize(64, 64))
                button.setFixedSize(160, 160)
            else:
                button.setIconSize(QSize(42, 42))
                button.setFixedSize(116, 116)
        else:
            button.setToolButtonStyle(Qt.ToolButtonTextBesideIcon)
            button.setIconSize(QSize(32, 32))
            button.setMinimumHeight(44)
        button.clicked.connect(lambda checked=False, command=command: self.launch(command))
        return button

    def filter(self, text):
        query = text.strip().lower()
        for button in self.buttons:
            button.setVisible(query in button.text().lower())

    def launch(self, command):
        subprocess.Popen(
            command,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        self.close()
        QApplication.quit()

    def place(self):
        if self.fullscreen:
            screen = QApplication.primaryScreen().geometry()
            self.setFixedSize(screen.width(), screen.height())
            self.move(screen.x(), screen.y())
            self.charms.setGeometry(screen.width() - 92, 0, 92, screen.height())
            self.charms.raise_()
            return
        screen = QApplication.primaryScreen().availableGeometry()
        position, panel_size = panel_position(self.layout_id)
        width, height = self.width(), self.height()
        gap = 8
        if position == "Top":
            x = gap
            y = panel_size + gap
        elif position == "Left":
            x = panel_size + gap
            y = max(gap, screen.height() - height - 90)
        elif position == "Right":
            x = max(gap, screen.width() - panel_size - width - gap)
            y = max(gap, screen.height() - height - 90)
        else:
            x = gap
            if self.layout_id == "chromeos":
                x = max(gap, (screen.width() - width) // 2)
            y = max(gap, screen.height() - panel_size - height - gap)
        if self.layout_id == "macos":
            x = gap
            y = panel_size + gap
        self.move(screen.x() + x, screen.y() + y)

    def keyPressEvent(self, event):
        if event.key() == Qt.Key_Escape:
            self.close()
        else:
            super().keyPressEvent(event)


def main():
    layout = sys.argv[1] if len(sys.argv) > 1 else "windows7"
    if layout not in CONFIGS:
        layout = "windows7"
    app = QApplication(sys.argv[:1])
    app.setQuitOnLastWindowClosed(True)
    app.setFont(QFont("DejaVu Sans", 10))
    menu = Menu(layout)
    menu.show()
    menu.search.setFocus()
    sys.exit(app.exec_())


if __name__ == "__main__":
    main()
