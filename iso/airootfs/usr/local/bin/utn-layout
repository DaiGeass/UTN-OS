#!/usr/bin/env bash
# Cambia la apariencia del escritorio a un layout preconfigurado.
# Los layouts están en /usr/share/utn-os/layouts (uno por carpeta).
set -euo pipefail

LAYOUT_DIR="/usr/share/utn-os/layouts"
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"
BACKUP_DIR="$CONF_DIR/utn-os-backup"

usage() {
    echo "Uso: utn-layout <layout>"
    echo "Cambia la apariencia del escritorio a un layout preconfigurado."
    echo
    echo "Layouts disponibles:"
    while IFS= read -r id; do
        [ -z "$id" ] && continue
        if [ -f "$LAYOUT_DIR/$id/meta.toml" ]; then
            display=$(sed -n 's/^display[[:space:]]*=[[:space:]]*"\([^"]*\)"/\1/p' \
                "$LAYOUT_DIR/$id/meta.toml" | head -n1)
            desc=$(sed -n 's/^description[[:space:]]*=[[:space:]]*"\([^"]*\)"/\1/p' \
                "$LAYOUT_DIR/$id/meta.toml" | head -n1)
        else
            display="$id"
            desc=""
        fi
        printf '  %-12s %-16s %s\n' "$id" "${display:-$id}" "$desc"
    done < <(ls -1 "$LAYOUT_DIR")
}

if [ $# -ne 1 ]; then
    usage
    exit 1
fi

LAYOUT="$1"
SRC="$LAYOUT_DIR/$LAYOUT"

if [ ! -d "$SRC" ]; then
    echo "Layout '$LAYOUT' no existe. Disponibles:"
    usage
    exit 1
fi

mkdir -p "$BACKUP_DIR"

copy_preset() {
    local src="$1"
    local dst="$2"
    local src_file="$SRC/$src"
    local dst_file="$CONF_DIR/$dst"
    if [ -f "$src_file" ]; then
        mkdir -p "$(dirname "$dst_file")"
        if [ -f "$dst_file" ] && [ ! -L "$dst_file" ]; then
            cp -a "$dst_file" "$BACKUP_DIR/$(basename "$dst")" 2>/dev/null || true
        fi
        mkdir -p "$(dirname "$src_file")"
        cp -a "$src_file" "$dst_file"
    fi
}

copy_preset lxqt/panel.conf lxqt/panel.conf
copy_preset lxqt/lxqt.conf lxqt/lxqt.conf
copy_preset openbox/rc.xml openbox/rc.xml
copy_preset pcmanfm/settings.conf pcmanfm/lxqt/settings.conf
copy_preset kvantum/kvantum.kvconfig Kvantum/kvantum.kvconfig
copy_preset picom.conf picom.conf

if command -v picom >/dev/null 2>&1; then
    pkill -x picom 2>/dev/null || true
    picom --config "$CONF_DIR/picom.conf" >/dev/null 2>&1 &
fi

if [ -n "${DISPLAY:-}" ]; then
    if command -v pcmanfm-qt >/dev/null 2>&1; then
        for w in wallpaper.svg wallpaper.png; do
            if [ -f "$SRC/$w" ]; then
                pcmanfm-qt --set-wallpaper "$SRC/$w" >/dev/null 2>&1 || true
                break
            fi
        done
    fi
    if command -v openbox >/dev/null 2>&1; then
        openbox --reconfigure 2>/dev/null || true
    fi
    if pgrep -x lxqt-panel >/dev/null 2>&1; then
        pkill -x lxqt-panel 2>/dev/null || true
        (setsid lxqt-panel >/dev/null 2>&1 &)
    fi
    echo "Layout '$LAYOUT' aplicado (cambios visibles al instante)."
else
    echo "Layout '$LAYOUT' aplicado. Cierra sesión y vuelve a entrar para ver los cambios."
fi