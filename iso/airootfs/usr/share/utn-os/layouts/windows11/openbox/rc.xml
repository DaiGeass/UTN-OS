<openbox_config xmlns="http://openbox.org/3.4/rc">
  <theme><name>Clearlooks</name></theme>
  <placement><policy>Smart</policy></placement>
  <desktops>
    <number>2</number>
    <names><name>Principal</name><name>Segundo</name></names>
